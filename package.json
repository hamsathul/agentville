{
  "name": "agentville",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local dashboard of every AI agent working on this Mac or Windows PC",
  "scripts": {
    "test": "node --import ./collector/test/win-links.mjs --test --test-timeout=120000 --test-force-exit \"collector/test/*.test.mjs\"",
    "test:ui": "node scripts/e2e-ui.mjs",
    "golden": "node scripts/world-golden.mjs",
    "new-world": "node scripts/new-world.mjs",
    "world-shots": "node scripts/world-shots.mjs",
    "check-world": "node scripts/check-world.mjs",
    "kit-sheet": "node scripts/kit-sheet.mjs",
    "demo": "node scripts/demo-video.mjs",
    "demo:many": "node scripts/demo-many.mjs",
    "start": "node collector/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamsathul/agentville.git"
  },
  "os": [
    "darwin",
    "win32"
  ]
}
